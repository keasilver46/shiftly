# 복사해서 application-local.yml 로 사용 (git 제외)
spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/shiftly
    username: shiftly
    password: shiftly
    driver-class-name: org.postgresql.Driver
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true

jwt:
  secret: change-me-to-a-long-random-string-at-least-32-bytes
  access-token-expiry: 1800        # 30분 (초)
  refresh-token-expiry: 1209600    # 14일 (초)
